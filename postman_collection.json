        {
          "name": "3. Crear producto - Invalidar cache",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var respuesta = pm.response.json();",
                  "    if (respuesta.datos && respuesta.datos.idProducto) {",
                  "        pm.collectionVariables.set(\"idProductoCache\", respuesta.datos.idProducto.toString());",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCategoria\": 1,\n  \"nombre\": \"Producto Test Cache\",\n  \"descripcion\": \"Producto para comprobar invalidacion de cache\",\n  \"talla\": \"L\",\n  \"color\": \"Negro\",\n  \"precio\": 50.00,\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
